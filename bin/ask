#!/usr/bin/env python3
import sys
import json
import urllib.request
import subprocess

MODEL = "gemma4:latest"
OLLAMA_API = "http://localhost:11434/api/chat"

def chat(messages, tools=None):
    data = {"model": MODEL, "messages": messages, "stream": False}
    if tools:
        data["tools"] = tools
        
    req = urllib.request.Request(
        OLLAMA_API, 
        data=json.dumps(data).encode('utf-8'), 
        headers={'Content-Type': 'application/json'}
    )
    with urllib.request.urlopen(req) as response:
        return json.loads(response.read().decode('utf-8'))["message"]

def main():
    prompt = " ".join(sys.argv[1:])
    if not sys.stdin.isatty():
        prompt = sys.stdin.read().strip() + "\n\n" + prompt

    if not prompt.strip():
        print("Usage: ask <prompt>")
        return

    tools = [{
        "type": "function",
        "function": {
            "name": "run_command",
            "description": "Execute a bash command on the user's local macOS machine. Only use this if you need information or need to mutate the system. The user will be prompted to approve the command.",
            "parameters": {
                "type": "object",
                "properties": {
                    "command": {"type": "string", "description": "The exact bash command to execute"}
                },
                "required": ["command"]
            }
        }
    }]

    messages = [
        {"role": "system", "content": "You are a helpful CLI assistant. You can use the run_command tool to execute shell commands to fulfill the user's request. Always be concise."},
        {"role": "user", "content": prompt}
    ]

    while True:
        try:
            message = chat(messages, tools)
        except Exception as e:
            print(f"\033[1;31m[Error] Failed to connect to Ollama: {e}\033[0m")
            print("Make sure Ollama is running and gemma4:latest is installed.")
            return

        messages.append(message)

        if "tool_calls" in message and message["tool_calls"]:
            for tool_call in message["tool_calls"]:
                func = tool_call["function"]
                if func["name"] == "run_command":
                    cmd = func["arguments"].get("command", "")
                    print(f"\n\033[1;33m[Agent wants to run]\033[0m \033[1;36m{cmd}\033[0m")
                    
                    if not sys.stdout.isatty() or not sys.stdin.isatty():
                        print("\033[1;31m[Error] Cannot ask for permission in a non-tty environment. Denying.\033[0m")
                        output = "Error: Permission denied (non-interactive environment)"
                    else:
                        ans = input("\033[1;32mAllow? (y/N): \033[0m").strip().lower()
                        if ans == 'y':
                            try:
                                result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
                                output = result.stdout + result.stderr
                                if not output.strip():
                                    output = "<Command completed with no output>"
                            except Exception as e:
                                output = f"Error executing command: {e}"
                        else:
                            print("\033[1;31mDenied.\033[0m")
                            output = "User denied permission to execute the command."
                    
                    messages.append({
                        "role": "tool",
                        "content": output
                    })
        else:
            if message.get("content"):
                print(f"\n{message['content'].strip()}")
            break

if __name__ == "__main__":
    main()
