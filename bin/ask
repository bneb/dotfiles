#!/usr/bin/env python3
import sys
import json
import urllib.request
import subprocess
import re
import select
import sqlite3
import os

MODEL = "gemma4:latest"
OLLAMA_API = "http://localhost:11434/api/chat"
MAX_ITERATIONS = 7
MAX_OUTPUT_LEN = 4000
DB_PATH = os.path.expanduser("~/.ask_history.db")

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS messages
                 (id INTEGER PRIMARY KEY AUTOINCREMENT,
                  role TEXT,
                  content TEXT,
                  tool_calls TEXT)''')
    conn.commit()
    return conn

def load_history(conn, limit=10):
    c = conn.cursor()
    c.execute('SELECT role, content, tool_calls FROM messages ORDER BY id DESC LIMIT ?', (limit,))
    rows = c.fetchall()
    messages = []
    for role, content, tool_calls_json in reversed(rows):
        msg = {"role": role, "content": content}
        if tool_calls_json:
            msg["tool_calls"] = json.loads(tool_calls_json)
        messages.append(msg)
    return messages

def save_message(conn, msg):
    c = conn.cursor()
    tool_calls_json = json.dumps(msg["tool_calls"]) if msg.get("tool_calls") else None
    c.execute('INSERT INTO messages (role, content, tool_calls) VALUES (?, ?, ?)',
              (msg["role"], msg.get("content", ""), tool_calls_json))
    conn.commit()

def clear_history(conn):
    c = conn.cursor()
    c.execute('DELETE FROM messages')
    conn.commit()

def strip_ansi(text):
    ansi_escape = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
    return ansi_escape.sub('', text)

def chat_stream(messages, tools=None):
    # Enforce deterministic behavior with temperature 0.0
    data = {"model": MODEL, "messages": messages, "stream": True, "options": {"temperature": 0.0}}
    if tools:
        data["tools"] = tools
        
    req = urllib.request.Request(
        OLLAMA_API, 
        data=json.dumps(data).encode('utf-8'), 
        headers={'Content-Type': 'application/json'}
    )
    
    full_content = ""
    tool_calls = []
    
    try:
        with urllib.request.urlopen(req) as response:
            for line in response:
                if not line:
                    continue
                chunk = json.loads(line.decode('utf-8').strip())
                msg = chunk.get("message", {})
                
                content_delta = msg.get("content", "")
                if content_delta:
                    sys.stdout.write(content_delta)
                    sys.stdout.flush()
                    full_content += content_delta
                
                if "tool_calls" in msg:
                    tool_calls = msg["tool_calls"]
                    
            if full_content:
                print()
                
    except Exception as e:
        print(f"\033[1;31m[Error] Failed to connect to Ollama: {e}\033[0m")
        sys.exit(1)
        
    return {"role": "assistant", "content": full_content, "tool_calls": tool_calls} if tool_calls else {"role": "assistant", "content": full_content}

def main():
    conn = init_db()
    
    # Handle flags
    args = sys.argv[1:]
    if "--clear" in args:
        clear_history(conn)
        print("\033[1;32m[Success] Memory cleared.\033[0m")
        return

    prompt = " ".join(args)
    if not sys.stdin.isatty():
        r, _, _ = select.select([sys.stdin], [], [], 0.0)
        if r:
            piped_data = sys.stdin.read().strip()
            if piped_data:
                prompt = piped_data + "\n\n" + prompt

    if not prompt.strip():
        print("Usage: ask <prompt>")
        print("       ask --clear  (clears conversation memory)")
        return

    tools = [{
        "type": "function",
        "function": {
            "name": "run_command",
            "description": "Execute a bash command on the user's local macOS machine. Only use this if you need information or need to mutate the system.",
            "parameters": {
                "type": "object",
                "properties": {
                    "command": {"type": "string", "description": "The exact bash command to execute"}
                },
                "required": ["command"]
            }
        }
    }]

    # Reconstruct sliding window context
    messages = [
        {"role": "system", "content": "You are a helpful CLI assistant. You can use the run_command tool to execute shell commands. Always be concise."}
    ]
    messages.extend(load_history(conn))
    
    user_msg = {"role": "user", "content": prompt}
    messages.append(user_msg)
    save_message(conn, user_msg)

    iterations = 0
    while iterations < MAX_ITERATIONS:
        iterations += 1
        
        message = chat_stream(messages, tools)
        messages.append(message)
        save_message(conn, message)

        if message.get("tool_calls"):
            for tool_call in message["tool_calls"]:
                func = tool_call.get("function", {})
                if func.get("name") == "run_command":
                    raw_cmd = func.get("arguments", {}).get("command", "")
                    clean_cmd = strip_ansi(raw_cmd)
                    
                    print(f"\033[1;33m[Agent wants to run]\033[0m \033[1;36m{clean_cmd}\033[0m")
                    
                    if not sys.stdout.isatty() or not sys.stdin.isatty():
                        print("\033[1;31m[Error] Cannot ask for permission in a non-tty environment. Denying.\033[0m")
                        output = "Error: Permission denied (non-interactive environment)"
                    else:
                        ans = input("\033[1;32mAllow? (y/N): \033[0m").strip().lower()
                        if ans == 'y':
                            try:
                                result = subprocess.run(clean_cmd, shell=True, capture_output=True, text=True)
                                output = result.stdout + result.stderr
                                if not output.strip():
                                    output = "<Command completed with no output>"
                                    
                                if len(output) > MAX_OUTPUT_LEN:
                                    half = MAX_OUTPUT_LEN // 2
                                    output = output[:half] + f"\n\n...[TRUNCATED {len(output) - MAX_OUTPUT_LEN} CHARS]...\n\n" + output[-half:]
                                    
                            except Exception as e:
                                output = f"Error executing command: {e}"
                        else:
                            print("\033[1;31mDenied.\033[0m")
                            output = "User denied permission to execute the command."
                    
                    tool_msg = {"role": "tool", "content": output}
                    messages.append(tool_msg)
                    save_message(conn, tool_msg)
        else:
            break
            
    if iterations >= MAX_ITERATIONS:
        print("\n\033[1;31m[Error] Agent reached maximum iteration limit.\033[0m")

if __name__ == "__main__":
    main()
