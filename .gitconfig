# ==============================================================================
# FILE: .gitconfig
# DESCRIPTION: Global Git configuration.
#              Forces rebasing on pull, enables auto-pruning of stale remote
#              branches, configures the global ignore file, and sets up high
#              efficiency aliases for committing and branching.
# ==============================================================================

[user]
	name = Kevin
	email = oconn.kv@gmail.com

[core]
	editor = vim
	ignorecase = false
	pager = less -FRX
	excludesfile = ~/.gitignore_global

[init]
	defaultBranch = main

[pull]
	rebase = true

[fetch]
	prune = true

[color]
	ui = auto

[alias]
	st = status -s
	co = checkout
	br = branch
	cm = commit -m
	amend = commit --amend --no-edit
	unstage = reset HEAD --
	last = log -1 HEAD
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
